# Copiar a .env (gitignored) y llenar. Nunca commitear .env.
# AWS_PROFILE: profile de la cuenta personal creado con `aws login --profile triage`.
TYPESAFE_API_KEY=
CLOUDFLARE_API_TOKEN=
AWS_PROFILE=triage
AWS_REGION=us-east-1
# Opcional: forzar modelo de Bedrock (si no, smoke_bedrock elige un Haiku disponible)
BEDROCK_MODEL_ID=
